# Copie este arquivo para ".env" (nome exato) e preencha.
# NUNCA envie o arquivo .env para ninguém nem publique na internet.

# Da seção "Open API" do seu painel de afiliado da Shopee
SHOPEE_APP_ID=cole_o_app_id_aqui
SHOPEE_APP_SECRET=cole_o_secret_aqui

# Do @BotFather e do seu canal (com @ na frente)
TELEGRAM_TOKEN=cole_o_token_aqui
CANAL=@seucanal

# O que o bot procura (separe por vírgula). Troque pelo seu nicho.
PALAVRAS=fone bluetooth,smartwatch,carregador turbo,caixa de som bluetooth

# Filtros de qualidade
DESCONTO_MIN=30
VENDAS_MIN=100
AVALIACAO_MIN=4.5
# Ordenar por: 1 relevância, 2 mais vendidos, 3 maior preço, 4 menor preço, 5 maior comissão
ORDENAR=2

# Horário (24h) e intervalo entre posts (minutos)
HORA_INICIO=8
HORA_FIM=22
INTERVALO_MIN=30
INTERVALO_MAX=90
